{
    "name": "laravelplus/repository-pattern",
    "description": "Laravel repository-pattern ",
    "keywords": [
        "laravelplus",
        "repository-pattern"
    ],
    "homepage": "https://github.com/laravelplus/repository-pattern",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nejc Cotic",
            "email": "info@after.si",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0",
        "nejcc/php-datatypes": "^1.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.15 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Laravelplus\\RepositoryPattern\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravelplus\\RepositoryPattern\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravelplus\\RepositoryPattern\\RepositoryPatternServiceProvider"
            ],
            "aliases": {
                "RepositoryPattern": "Laravelplus\\RepositoryPattern\\RepositoryPatternFacade"
            }
        }
    }
}
